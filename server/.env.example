# TOLII OTP Authentication Server Configuration
# Copy this file to .env or configure these environment variables in your deployment dashboard (e.g. Render, Railway, AWS, Heroku)

# Server Port (Render sets this dynamically)
PORT=3000

# -----------------------------------------------------------------------------------------
# PRIMARY EMAIL PROVIDER: Gmail API (OAuth2 over HTTPS)
# Advantages: 100% Primary Inbox placement, Zero Spam, <1 second latency, 500 emails/day FREE
# -----------------------------------------------------------------------------------------
GMAIL_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token
SMTP_USER=tolii.team@gmail.com

# -----------------------------------------------------------------------------------------
# FALLBACK 1: SendGrid HTTP API
# Free Tier: 100 emails/day, can send to any recipient
# -----------------------------------------------------------------------------------------
SENDGRID_API_KEY=your_sendgrid_api_key

# -----------------------------------------------------------------------------------------
# FALLBACK 2: Mailjet HTTP API
# Free Tier: 200 emails/day
# -----------------------------------------------------------------------------------------
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key

# -----------------------------------------------------------------------------------------
# FALLBACK 3: Resend HTTP API
# -----------------------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key

# -----------------------------------------------------------------------------------------
# SECURITY CONFIGURATION
# Salt key used for HMAC-SHA256 OTP hashing in memory
# -----------------------------------------------------------------------------------------
OTP_SECRET=your_secure_random_string_salt

# -----------------------------------------------------------------------------------------
# FIREBASE ADMIN SDK
# Raw JSON string of your Firebase Service Account Private Key for minting Custom Tokens
# -----------------------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=

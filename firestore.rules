rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if authenticated user is the host of an activity
    function isActivityHost(activityId) {
      return isAuthenticated() 
             && get(/databases/$(database)/documents/activities/$(activityId)).data.hostId == request.auth.uid;
    }

    // Users Collection Security Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Allow create: must be authenticated owner AND data.uid must match userId
      allow create: if isOwner(userId) 
                    && request.resource.data.uid == userId;
      
      // Allow update: must be authenticated owner AND data.uid must match userId AND existing doc uid (if present) must match userId
      allow update: if isOwner(userId) 
                    && request.resource.data.uid == userId
                    && (!('uid' in resource.data) || resource.data.uid == userId);
                    
      allow delete: if false;

      match /joined_communities/{communityId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Usernames Collection Security Rules (Atomic Global Uniqueness & Immutability)
    match /usernames/{username} {
      allow read: if isAuthenticated();
      
      // Allow create: user can only claim username doc with their own auth uid
      allow create: if isAuthenticated() 
                    && request.resource.data.uid == request.auth.uid;
                    
      // Usernames are immutable: clients cannot update or delete existing username documents
      allow update: if false;
      allow delete: if false;
    }

    // Activities Collection Security Rules
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      
      // Host must match authenticated user UID on create
      allow create: if isAuthenticated() 
                    && request.resource.data.hostId == request.auth.uid;
                    
      // Host can update activity (hostId must remain immutable), or participant updating participantIds/joinedPlayers when joining/leaving
      allow update: if isAuthenticated() 
                    && ((resource.data.hostId == request.auth.uid && request.resource.data.hostId == resource.data.hostId)
                        || (request.auth.uid in resource.data.participantIds 
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'joinedPlayers', 'updatedAt'])));

      // Host can delete activity
      allow delete: if isAuthenticated() 
                    && resource.data.hostId == request.auth.uid;

      // Subcollection: Participants
      match /participants/{participantUid} {
        allow read: if isAuthenticated();
        
        // Host or the participant themselves can write/delete participant record
        allow create, update, delete: if isAuthenticated() 
                                      && (request.auth.uid == participantUid 
                                          || isActivityHost(activityId));
      }

      // Subcollection: Requests to Join
      match /requests/{requestUid} {
        allow read: if isAuthenticated() 
                    && (request.auth.uid == requestUid 
                        || isActivityHost(activityId));
                        
        allow create: if isAuthenticated() 
                      && request.auth.uid == requestUid
                      && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
        
        allow update: if isAuthenticated() 
                      && ((request.auth.uid == requestUid && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid))
                          || isActivityHost(activityId));

        allow delete: if isAuthenticated() 
                      && (request.auth.uid == requestUid 
                          || isActivityHost(activityId));
      }
    }

    // Community Chat & Membership Security Rules
    match /community/{communityId} {
      allow read: if isAuthenticated();

      match /members/{memberUid} {
        allow read: if isAuthenticated();
        allow create, delete: if isOwner(memberUid);
      }

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        
        allow create: if isAuthenticated() 
                      && request.resource.data.senderId == request.auth.uid;
                      
        allow update: if isAuthenticated() 
                      && resource.data.senderId == request.auth.uid
                      && request.resource.data.senderId == resource.data.senderId;

        allow delete: if isAuthenticated() 
                      && resource.data.senderId == request.auth.uid;
      }
    }

    // Conversations & Private Chat Security Rules
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() 
                  && request.auth.uid in resource.data.participantIds;
                  
      allow create: if isAuthenticated() 
                    && request.auth.uid in request.resource.data.participantIds;

      allow update: if isAuthenticated() 
                    && request.auth.uid in resource.data.participantIds
                    && request.resource.data.participantIds.hasAll(resource.data.participantIds);

      match /messages/{messageId} {
        allow read: if isAuthenticated() 
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
                    
        allow create: if isAuthenticated() 
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
                      && request.resource.data.senderId == request.auth.uid;

        allow update: if isAuthenticated() 
                      && resource.data.senderId == request.auth.uid
                      && request.resource.data.senderId == resource.data.senderId;

        allow delete: if isAuthenticated() 
                      && resource.data.senderId == request.auth.uid;
      }
    }

    // In-App Notifications Security Rules
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() 
                                  && resource.data.recipientId == request.auth.uid;
                                  
      allow create: if isAuthenticated()
                    && request.resource.data.senderId == request.auth.uid;
    }
  }
}
